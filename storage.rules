rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Logos uploadés par l'utilisateur
    match /users/{userId}/logos/{filename} {
      allow read: if true;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 500 * 1024
        && request.resource.contentType.matches('image/png|image/svg\\+xml|image/jpeg');
    }
    // Images artistiques
    match /users/{userId}/artworks/{filename} {
      allow read: if true;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/png|image/jpeg');
    }
  }
}
